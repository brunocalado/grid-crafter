{
  "id": "grid-crafter",
  "title": "Grid Crafter",
  "description": "Craft items by arranging ingredients on a 3x3 grid, in any system.",
  "version": "0.0.4",

  "authors": [
    {
      "name": "Mestre Digital",
      "url": "http://youtube.com/@mestredigital",
      "flags": {}
    }
  ],

  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },

  "esmodules": ["scripts/main.js"],
  "styles": [
    "styles/base.css",
    "styles/forge-app.css",
    "styles/recipe-editor-app.css",
    "styles/dialog.css",
    "styles/item-types-config.css",
    "styles/recipe-reveal-app.css",
    "styles/share-recipe-app.css",
    "styles/sound-config.css",
    "styles/teach-recipe-app.css",
    "styles/chat-card.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],

  "relationships": {
    "recommends": [
      {
        "id": "canvas-loot",
        "type": "module",
        "manifest": "https://github.com/brunocalado/canvas-loot/releases/latest/download/module.json",
        "reason": "Forged items can be dragged from the forge straight onto the map."
      }
    ]
  },

  "url": "https://github.com/brunocalado/grid-crafter",
  "manifest": "https://github.com/brunocalado/grid-crafter/releases/latest/download/module.json",
  "download": "https://github.com/brunocalado/grid-crafter/releases/latest/download/module.zip"
}
