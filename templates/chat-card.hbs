<div class="grid-crafter gc-chat-card gc-theme-{{theme}} {{#if success}}gc-success{{else}}gc-failure{{/if}}">
  <header class="gc-chat-header">
    {{#if success}}
    <i class="fa-solid fa-sparkles" inert></i>
    <h3>{{localize "GRIDCRAFTER.Chat.Success" name=actorName}}</h3>
    {{else if (eq state "refused")}}
    <i class="fa-solid fa-box-open" inert></i>
    <h3>{{localize "GRIDCRAFTER.Chat.Refused" name=actorName}}</h3>
    {{else if (eq state "missing")}}
    <i class="fa-solid fa-lock" inert></i>
    <h3>{{localize "GRIDCRAFTER.Chat.Missing" name=actorName}}</h3>
    {{else if (eq state "incomplete")}}
    <i class="fa-solid fa-triangle-exclamation" inert></i>
    <h3>{{localize "GRIDCRAFTER.Chat.Incomplete" name=actorName}}</h3>
    {{else}}
    <i class="fa-solid fa-burst" inert></i>
    <h3>{{localize "GRIDCRAFTER.Chat.Failure" name=actorName}}</h3>
    {{/if}}
  </header>

  {{#if result}}
  <div class="gc-chat-result {{#unless success}}gc-chat-missing{{/unless}}">
    <img src="{{result.img}}" alt="">
    <div>
      <strong>{{result.name}}</strong>{{#if result.quantity}} <span>×{{result.quantity}}</span>{{/if}}
      <small>{{recipeName}}</small>
    </div>
  </div>
  {{/if}}
  {{#if required}}
  <p class="gc-chat-required {{#if (eq state "missing")}}gc-chat-missing{{/if}}">
    <img src="{{required.img}}" alt=""> <span>{{required.label}}</span>
  </p>
  {{/if}}
  {{#if (eq state "refused")}}
  <p class="gc-chat-message">{{localize "GRIDCRAFTER.Chat.RefusedMessage" name=actorName}}</p>
  {{else if (eq state "incomplete")}}
  <p class="gc-chat-message">{{localize "GRIDCRAFTER.Chat.IncompleteMessage" name=actorName}}</p>
  {{else if (eq state "failure")}}
  <p class="gc-chat-message">{{localize "GRIDCRAFTER.Chat.FailureMessage"}}</p>
  {{/if}}

  <h4>{{#if spent}}{{localize "GRIDCRAFTER.Chat.Spent"}}{{else}}{{localize "GRIDCRAFTER.Chat.Attempted"}}{{/if}}</h4>
  <ul class="gc-chat-items">
    {{#each groups}}
    <li>
      <img src="{{img}}" alt="">
      <span class="gc-chat-name">{{name}}{{#if (gt count 1)}} ×{{count}}{{/if}}</span>
      <span class="gc-origin gc-origin-{{origin}}">{{originLabel}}</span>
    </li>
    {{/each}}
  </ul>

  {{#if (eq state "failure")}}
  <p class="gc-chat-loss">
    {{#if lost}}<i class="fa-solid fa-fire" inert></i> {{localize "GRIDCRAFTER.Chat.Lost" chance=chance}}
    {{else if chance}}<i class="fa-solid fa-shield" inert></i> {{localize "GRIDCRAFTER.Chat.Kept" chance=chance}}
    {{else}}{{localize "GRIDCRAFTER.Chat.NoLoss"}}{{/if}}
  </p>
  {{/if}}
</div>
