<div class="gc-editor-body">
  {{#*inline "entries"}}
  <ol>
    {{#each recipes}}
    <li data-search="{{search}}">
      <button type="button" class="gc-recipe-entry {{#if active}}gc-active{{/if}}" data-action="selectRecipe" data-recipe-id="{{id}}"
              {{#if origin}}data-tooltip="{{origin}}"{{/if}}>
        {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="gc-noimg"></span>{{/if}}
        <span>{{name}}</span>
      </button>
      {{#if (or public edited)}}
      <span class="gc-row-markers">
        {{#if edited}}<i class="fa-solid fa-pen-nib gc-edited-marker" data-tooltip="GRIDCRAFTER.Editor.EditedMarker"></i>{{/if}}
        {{#if public}}<i class="fa-solid fa-people-group gc-public-marker" data-tooltip="GRIDCRAFTER.Editor.PublicMarker"></i>{{/if}}
      </span>
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{/inline}}
  {{#*inline "head"}}
  <summary class="gc-group-head">
    <i class="fa-solid fa-chevron-right gc-chevron"></i>
    {{#if hiddenGroup}}<i class="fa-solid fa-box-archive gc-hidden-glyph" inert></i>{{/if}}
    <span class="gc-group-label">{{label}}</span>
    <span class="gc-group-picked" hidden></span>
    <span class="gc-group-count">{{count}}</span>
  </summary>
  {{/inline}}
  <aside class="gc-recipe-list">
    <button type="button" class="gc-button gc-new" data-action="newRecipe" {{#if selecting}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{localize "GRIDCRAFTER.Editor.New"}}</button>
    <div class="gc-list-tools">
      <div class="gc-search">
        <i class="fa-solid fa-magnifying-glass" inert></i>
        <input type="text" name="search" value="{{query}}" autocomplete="off"
               placeholder="{{localize "GRIDCRAFTER.Search.Placeholder"}}" aria-label="{{localize "GRIDCRAFTER.Search.Label"}}">
      </div>
      <button type="button" class="gc-icon-button gc-select-mode {{#if selecting}}gc-active{{/if}}"
              data-action="toggleSelect" aria-pressed="{{selecting}}" data-tooltip="GRIDCRAFTER.Editor.Select">
        <i class="fa-solid fa-list-check" inert></i>
      </button>
    </div>
    <div class="gc-recipe-scroll">
      {{#each groups}}
      <details class="gc-group {{#if hiddenGroup}}gc-hidden-group{{/if}}" data-group="{{key}}" {{#unless collapsed}}open{{/unless}}>
        {{> head}}
        {{#if categories}}
        {{#each categories}}
        <details class="gc-group gc-subgroup" data-group="{{key}}" {{#unless collapsed}}open{{/unless}}>
          {{> head}}
          {{> entries}}
        </details>
        {{/each}}
        {{else}}
        {{> entries}}
        {{/if}}
      </details>
      {{else}}
      <p class="gc-empty">{{localize "GRIDCRAFTER.Editor.Empty"}}</p>
      {{/each}}
      <p class="gc-empty gc-no-match" hidden>{{localize "GRIDCRAFTER.Search.NoMatch"}}</p>
    </div>
  </aside>

  <section class="gc-recipe-detail">
    <div class="gc-recipe-fields" {{#if selecting}}inert{{/if}}>
      <div class="gc-fields-row gc-fields-top">
        <fieldset class="gc-field gc-name">
          <legend>{{localize "GRIDCRAFTER.Recipe.Name"}}</legend>
          <input type="text" name="name" value="{{draft.name}}" placeholder="{{draft.result.name}}">
        </fieldset>
        <fieldset class="gc-field gc-public">
          <legend>{{localize "GRIDCRAFTER.Recipe.Public"}}</legend>
          <input type="checkbox" class="gc-toggle" name="public" {{#if isPublic}}checked{{/if}}>
          <i class="fa-solid fa-circle-question gc-help" data-tooltip-html="{{publicHelp}}"
             data-tooltip-class="grid-crafter gc-tooltip gc-theme-{{theme}}" data-tooltip-direction="UP"></i>
        </fieldset>
        <fieldset class="gc-field gc-shape">
          <legend>{{localize "GRIDCRAFTER.Recipe.Shape"}}</legend>
          <label><input type="radio" name="shaped" value="shaped" {{#if draft.shaped}}checked{{/if}}> {{localize "GRIDCRAFTER.Recipe.Shaped"}}</label>
          <label><input type="radio" name="shaped" value="shapeless" {{#unless draft.shaped}}checked{{/unless}}> {{localize "GRIDCRAFTER.Recipe.Shapeless"}}</label>
          <i class="fa-solid fa-circle-question gc-help" data-tooltip-html="{{shapeHelp}}"
             data-tooltip-class="grid-crafter gc-tooltip gc-theme-{{theme}}" data-tooltip-direction="LEFT"></i>
        </fieldset>
      </div>
      <div class="gc-fields-row">
        <fieldset class="gc-field gc-loss">
          <legend>{{localize "GRIDCRAFTER.Recipe.FailLoss"}}</legend>
          <label class="gc-inherit">
            <input type="checkbox" class="gc-toggle" name="inherit" {{#if inherit}}checked{{/if}}>
            <span>{{localize "GRIDCRAFTER.Recipe.Inherit"}}</span>
          </label>
          {{#unless inherit}}
          <input type="range" name="failLossChance" min="0" max="100" step="5" value="{{lossChance}}">
          {{/unless}}
          <output class="gc-loss-value">{{lossChance}}%</output>
        </fieldset>
        <fieldset class="gc-field gc-discovery">
          <legend>{{localize "GRIDCRAFTER.Recipe.Discovery"}}</legend>
          <label class="gc-inherit">
            <input type="checkbox" class="gc-toggle" name="discoverInherit" {{#if discoverInherit}}checked{{/if}}>
            <span>{{localize "GRIDCRAFTER.Recipe.Inherit"}}</span>
          </label>
          {{#unless discoverInherit}}
          <input type="checkbox" class="gc-toggle" name="discoverable" {{#if discoverable}}checked{{/if}}
                 aria-label="{{localize "GRIDCRAFTER.Recipe.Discovery"}}">
          {{/unless}}
          <output class="gc-discovery-value">{{#if discoverable}}{{localize "GRIDCRAFTER.Recipe.Yes"}}{{else}}{{localize "GRIDCRAFTER.Recipe.No"}}{{/if}}</output>
          <i class="fa-solid fa-circle-question gc-help" data-tooltip-html="{{discoveryHelp}}"
             data-tooltip-class="grid-crafter gc-tooltip gc-theme-{{theme}}" data-tooltip-direction="UP"></i>
        </fieldset>
        <fieldset class="gc-field gc-quantity">
          <legend>{{localize "GRIDCRAFTER.Recipe.Quantity"}}</legend>
          <input type="range" name="quantity" min="1" max="10" step="1" value="{{draft.quantity}}">
          <output class="gc-quantity-value">{{draft.quantity}}</output>
          <i class="fa-solid fa-circle-question gc-help" data-tooltip-html="{{quantityHelp}}"
             data-tooltip-class="grid-crafter gc-tooltip gc-theme-{{theme}}" data-tooltip-direction="LEFT"></i>
        </fieldset>
      </div>
    </div>

    <div class="gc-recipe-board" {{#if selecting}}inert{{/if}}>
      <div class="gc-grid {{#unless draft.shaped}}gc-shapeless{{/unless}}">
        {{#each cells}}
        <div class="gc-cell" data-drop="cell" data-index="{{index}}" {{#if item}}data-tooltip="{{item.name}}"{{/if}}>
          {{#if item}}
          <img src="{{item.img}}" alt="{{item.name}}">
          <button type="button" class="gc-cell-clear" data-action="clearCell" aria-label="{{localize "GRIDCRAFTER.Forge.Remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
          {{/if}}
        </div>
        {{/each}}
      </div>
      <i class="fa-solid fa-angles-right gc-board-arrow" inert></i>
      <div class="gc-result-column">
        <div class="gc-cell gc-result" data-drop="result" data-tooltip="{{#if draft.result}}{{draft.result.name}}{{else}}{{localize "GRIDCRAFTER.Editor.DropResult"}}{{/if}}">
          {{#if draft.result}}
          <img src="{{draft.result.img}}" alt="{{draft.result.name}}">
          <button type="button" class="gc-cell-clear" data-action="clearResult" aria-label="{{localize "GRIDCRAFTER.Forge.Remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
          {{/if}}
        </div>
        <div class="gc-requires {{#unless draft.requires}}gc-empty{{/unless}}" data-drop="requires"
             data-tooltip="{{#if draft.requires}}{{localize "GRIDCRAFTER.Recipe.Requires" name=draft.requires.name}}{{else}}{{localize "GRIDCRAFTER.Editor.DropRequires"}}{{/if}}">
          {{#if draft.requires}}
          <img src="{{draft.requires.img}}" alt="{{draft.requires.name}}">
          <button type="button" class="gc-cell-clear" data-action="clearRequires" aria-label="{{localize "GRIDCRAFTER.Forge.Remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
          {{else}}
          <i class="fa-solid fa-key" inert></i>
          {{/if}}
        </div>
      </div>
    </div>

    <footer class="gc-editor-controls">
      {{#if selecting}}
      <button type="button" class="gc-button" data-action="teachRecipe" {{#unless picked}}disabled{{/unless}}>
        <i class="fa-solid fa-graduation-cap" inert></i> {{localize "GRIDCRAFTER.Editor.Teach"}} <span class="gc-picked-count">{{picked}}</span>
      </button>
      <button type="button" class="gc-button gc-danger" data-action="forgetRecipe" {{#unless picked}}disabled{{/unless}}>
        <i class="fa-solid fa-eraser" inert></i> {{localize "GRIDCRAFTER.Editor.Forget"}} <span class="gc-picked-count">{{picked}}</span>
      </button>
      {{else}}
      <button type="button" class="gc-button gc-category {{#unless draft.category}}gc-unset{{/unless}}"
              data-action="setCategory"
              data-tooltip="{{#if draft.category}}{{draft.category}}{{else}}{{localize "GRIDCRAFTER.Editor.CategoryHint"}}{{/if}}">
        <i class="fa-solid fa-tag" inert></i>
        <span>{{#if draft.category}}{{draft.category}}{{else}}{{localize "GRIDCRAFTER.Recipe.Category"}}{{/if}}</span>
      </button>
      {{#if isPackage}}
      {{#if edited}}
      <button type="button" class="gc-button" data-action="restoreRecipe"><i class="fa-solid fa-rotate-left" inert></i> {{localize "GRIDCRAFTER.Editor.Restore"}}</button>
      {{/if}}
      {{else}}
      <button type="button" class="gc-button gc-danger" data-action="deleteRecipe"><i class="fa-solid fa-trash" inert></i> {{#if isNew}}{{localize "GRIDCRAFTER.Editor.Discard"}}{{else}}{{localize "GRIDCRAFTER.Editor.Delete"}}{{/if}}</button>
      {{/if}}
      <div class="gc-recipe-tools">
        <button type="button" class="gc-icon-button {{#if hidden}}gc-active{{/if}}" data-action="hideRecipe"
                {{#if isNew}}disabled{{/if}} aria-pressed="{{hidden}}"
                aria-label="{{#if hidden}}{{localize "GRIDCRAFTER.Editor.ShowHint"}}{{else}}{{localize "GRIDCRAFTER.Editor.HideHint"}}{{/if}}"
                data-tooltip="{{#if hidden}}GRIDCRAFTER.Editor.ShowHint{{else}}GRIDCRAFTER.Editor.HideHint{{/if}}">
          <i class="fa-solid {{#if hidden}}fa-box-open{{else}}fa-box-archive{{/if}}" inert></i>
        </button>
        <button type="button" class="gc-icon-button" data-action="duplicateRecipe" {{#if isNew}}disabled{{/if}}
                aria-label="{{localize "GRIDCRAFTER.Editor.DuplicateHint"}}" data-tooltip="GRIDCRAFTER.Editor.DuplicateHint"><i class="fa-solid fa-clone" inert></i></button>
      </div>
      <div class="gc-knowledge">
        <button type="button" class="gc-icon-button" data-action="shareRecipe" {{#if isNew}}disabled{{/if}}
                aria-label="{{localize "GRIDCRAFTER.Editor.Share"}}" data-tooltip="GRIDCRAFTER.Editor.ShareHint"><i class="fa-solid fa-eye" inert></i></button>
        <button type="button" class="gc-icon-button" data-action="teachRecipe" {{#if isNew}}disabled{{/if}}
                aria-label="{{localize "GRIDCRAFTER.Editor.Teach"}}" data-tooltip="GRIDCRAFTER.Editor.TeachHint"><i class="fa-solid fa-graduation-cap" inert></i></button>
        <button type="button" class="gc-icon-button gc-danger" data-action="forgetRecipe" {{#if isNew}}disabled{{/if}}
                aria-label="{{localize "GRIDCRAFTER.Editor.Forget"}}" data-tooltip="GRIDCRAFTER.Editor.ForgetHint"><i class="fa-solid fa-eraser" inert></i></button>
      </div>
      <button type="button" class="gc-button gc-save {{#if dirty}}gc-dirty{{/if}}" data-action="saveRecipe"><i class="fa-solid fa-floppy-disk" inert></i> {{localize "GRIDCRAFTER.Editor.Save"}}</button>
      {{/if}}
    </footer>
  </section>
</div>
